{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "cifp": {
      "type": "object",
      "properties": {
        "alumnos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "nombre", "apellidos", "fecha_matrícula", "curso"],
            "properties": {
              "id": { "type": "integer" },
              "nombre": { "type": "string" },
              "apellidos": { "type": "string" },
              "teléfono": { "type": "string" },
              "fecha_matrícula": { "type": "string" },
              "curso": { "enum": ["DAM", "DAW", "ASIX", "SMX", "SEIA", "ER", "AUT"] }
            }
          }
        }
      }
    }
  }
}